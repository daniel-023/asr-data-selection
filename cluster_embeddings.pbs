#!/bin/bash
#PBS -N cluster_embeddings
#PBS -j oe
#PBS -l select=1:ncpus=4:mem=32gb
#PBS -l walltime=2:00:00
# Submit with: qsub -P <project-code> cluster_embeddings.pbs

set -euo pipefail

WORKDIR="${WORKDIR:-${HOME}/scratch/embedding_analysis}"
OUT="${OUT:-${WORKDIR}/embeddings}"
PYTHON="${PYTHON:-${HOME}/scratch/micromamba/envs/speech_lab/bin/python}"
FEATURE_SETS="${FEATURE_SETS:-sbert wavlm_mfa sbert_mfa sbert_wavlm sbert_wavlm_mfa}"

cd "${WORKDIR}"

if [[ ! -x "${PYTHON}" ]]; then
  echo "Python is not executable: ${PYTHON}" >&2
  exit 1
fi

export PATH="$(dirname "${PYTHON}"):${PATH}"

read -r -a FEATURE_SET_ARGS <<< "${FEATURE_SETS}"

"${PYTHON}" cluster_embeddings.py \
  --out-root "${OUT}" \
  --feature-sets "${FEATURE_SET_ARGS[@]}"
