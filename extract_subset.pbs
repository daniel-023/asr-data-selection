#!/bin/bash
#PBS -N extract_subset
#PBS -j oe
#PBS -l select=1:ncpus=4:mem=32gb
#PBS -l walltime=4:00:00
# Submit with: qsub -P <project-code> extract_subset.pbs

set -euo pipefail

WORKDIR="${WORKDIR:-${HOME}/scratch/embedding_analysis}"
OUTPUT_ROOT="${OUTPUT_ROOT:-${WORKDIR}}"

cd "${WORKDIR}"

eval "$(micromamba shell hook --shell bash)"
micromamba activate speech_lab
PYTHON="${PYTHON:-python}"

if [[ -z "${OUTPUT_ROOT}" || "${OUTPUT_ROOT}" == "/" ]]; then
  echo "Refusing to delete unsafe OUTPUT_ROOT='${OUTPUT_ROOT}'" >&2
  exit 1
fi

mkdir -p "${OUTPUT_ROOT}"
if [[ "$(realpath "${OUTPUT_ROOT}")" == "$(realpath "${WORKDIR}")" ]]; then
  rm -rf "${OUTPUT_ROOT}/audio/data_selection_13200"
  rm -f "${OUTPUT_ROOT}/metadata/selected_manifest.json"
  rm -f "${OUTPUT_ROOT}/metadata/selected_manifest.jsonl"
  rm -f "${OUTPUT_ROOT}/metadata/reference.jsonl"
  rm -f "${OUTPUT_ROOT}/metadata/candidate.jsonl"
else
  rm -rf "${OUTPUT_ROOT}"
  mkdir -p "${OUTPUT_ROOT}"
fi

"${PYTHON}" extract_subset.py \
  --output-root "${OUTPUT_ROOT}"
