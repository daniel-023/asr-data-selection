#!/bin/bash
#PBS -N extract_embeddings
#PBS -j oe
#PBS -l select=1:ncpus=4:mem=64gb:ngpus=1
#PBS -l walltime=12:00:00
# Submit with: qsub -P <project-code> extract_embeddings.pbs

set -euo pipefail

WORKDIR="${WORKDIR:-${HOME}/scratch/embedding_analysis}"
MANIFEST="${MANIFEST:-${WORKDIR}/metadata/selected_manifest.whisper_large_v3.json}"
OUT_ROOT="${OUT_ROOT:-${WORKDIR}/embeddings}"
MFA_CHECKPOINT="${MFA_CHECKPOINT:-${WORKDIR}/checkpoints/MFA_conformer.ckpt}"
PYTHON="${PYTHON:-${HOME}/scratch/micromamba/envs/speech_lab/bin/python}"
SBERT_MODEL="${SBERT_MODEL:-all-mpnet-base-v2}"
BATCH_SIZE="${BATCH_SIZE:-8}"
SBERT_BATCH_SIZE="${SBERT_BATCH_SIZE:-64}"
ENCODERS="${ENCODERS:-wavlm mfa_conformer sbert}"
SEMANTIC_SOURCES="${SEMANTIC_SOURCES:-gt pseudo}"

cd "${WORKDIR}"

if [[ ! -x "${PYTHON}" ]]; then
  echo "Python is not executable: ${PYTHON}" >&2
  exit 1
fi

export PATH="$(dirname "${PYTHON}"):${PATH}"

mkdir -p "${OUT_ROOT}"

read -r -a ENCODER_ARGS <<< "${ENCODERS}"
read -r -a SEMANTIC_SOURCE_ARGS <<< "${SEMANTIC_SOURCES}"

"${PYTHON}" extract_embeddings.py \
  --manifest "${MANIFEST}" \
  --out-root "${OUT_ROOT}" \
  --mfa-checkpoint "${MFA_CHECKPOINT}" \
  --device cuda \
  --batch-size "${BATCH_SIZE}" \
  --encoders "${ENCODER_ARGS[@]}" \
  --semantic-sources "${SEMANTIC_SOURCE_ARGS[@]}" \
  --sbert-model "${SBERT_MODEL}" \
  --sbert-batch-size "${SBERT_BATCH_SIZE}"
